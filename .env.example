# CDM LibHub Promotional Website — Environment Configuration Example
# Copy this file to .env for local Node.js server customization

# Port for local static server (default: 5000)
PORT=5000

# Mother System Portal URL (CDM OneServe)
MOTHER_SYSTEM_PORTAL_URL=https://student.cdmconnect.online

# Live Mobile App PWA URL (Once deployed by mother system team)
# Example: https://student.cdmconnect.online/library/mobile
MOBILE_APP_URL=http://localhost:5173/mobile

# Live Desktop Librarian Terminal URL (Once deployed by mother system team)
# Example: https://admin.cdmconnect.online/library
DESKTOP_APP_URL=http://localhost:5173/

# Optional: Live Books REST API endpoint
API_BOOKS_URL=http://localhost:5002/api/books
